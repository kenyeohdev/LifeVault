# Copy this to .env.local for local dev, and set the same keys as Railway
# environment variables for production.

# Postgres connection string. Locally: run a local Postgres or use Railway's.
# On Railway: add a Postgres service, then copy its DATABASE_URL here (or
# reference it as ${{Postgres.DATABASE_URL}} in Railway's own env settings).
DATABASE_URL="postgresql://user:password@localhost:5432/lifevault"

# From your Clerk dashboard (clerk.com) → API Keys. Use test keys for local
# dev, live keys in production.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Clerk's default routes — matches the pages this app ships with.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/onboarding"
